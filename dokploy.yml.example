# yaml-language-server: $schema=https://raw.githubusercontent.com/pythoninthegrass/icarus/main/schemas/dokploy.schema.json

project:
  name: my-project
  description: |
    My project deployed via Dokploy

  # Which apps receive the filtered .env file
  env_targets: [web, worker]

  # Deploy waves: sequential outer list, parallel inner lists
  # Wave 1 completes before wave 2 starts
  deploy_order:
    - [redis]
    - [web, worker]

# GitHub defaults for all github-sourced apps
# Omit this entire section for Docker-only projects
github:
  owner: your-org
  repository: your-repo
  branch: main

# Per-environment overrides (merged into base config at runtime)
environments:
  prod:
    apps:
      web:
        domain:
          host: app.example.com
          port: 8000
          https: true
          certificateType: letsencrypt
        autoDeploy: true
        replicas: 2
  dev:
    github:
      branch: develop
    apps:
      web:
        domain:
          host: app-dev.example.com
          port: 8000
          https: true
          certificateType: letsencrypt

apps:
  - name: redis
    source: docker
    dockerImage: redis:7-alpine
    volumes:
      - source: redis_data
        target: /data
        type: volume
    ports:
      - publishedPort: 6379
        targetPort: 6379
        # protocol: tcp           # tcp (default) | udp
        # publishMode: ingress    # ingress (default) | host
    # Scheduled Docker volume backups (any service type, unlike database `backups`)
    # volumeBackups:
    #   - name: redis-data
    #     volumeName: redis_data
    #     prefix: redis-data
    #     cronExpression: "0 4 * * *"
    #     destination: s3-backups
    #     keepLatestCount: 7

  - name: web
    source: github
    # Build settings (defaults shown)
    buildType: dockerfile         # dockerfile | nixpacks | static | heroku_buildpacks | paketo_buildpacks | railpack
    dockerfile: Dockerfile         # Dockerfile path (buildType: dockerfile only)
    # dockerContextPath: ""      # Docker build context (buildType: dockerfile only)
    # dockerBuildStage: ""       # Multi-stage target (buildType: dockerfile only)
    # publishDirectory: ""       # Output dir (buildType: static only)
    buildPath: /                 # Build path for GitHub provider
    triggerType: push            # push | manual
    autoDeploy: true             # Auto-deploy on push
    # replicas: 1                # Number of replicas
    # watchPaths:                # File paths to watch for auto-deploy
    #   - "src/**"
    #   - Dockerfile
    # create_env_file: false      # Write env vars to .env in container workdir
    # Container resource limits (applied via Docker swarm)
    # resources:
    #   memoryLimit: 512M          # Bytes, or K/M/G/T suffix (1024-based)
    #   memoryReservation: 256M    # Soft reservation
    #   cpuLimit: 1                # CPUs (e.g. 0.5, 1, 2)
    #   cpuReservation: 0.5
    # Swarm health check for the app container
    # healthCheck:
    #   command: curl -f http://localhost/health  # String runs via CMD-SHELL; list = raw Test array
    #   interval: 30s              # ms/s/m/h suffixes; bare numbers are seconds
    #   timeout: 10s
    #   startPeriod: 60s           # Grace period before failures count
    #   retries: 3
    # Swarm restart policy for the app container
    # restartPolicy:
    #   condition: on-failure      # none | on-failure | any
    #   delay: 5s
    #   maxAttempts: 3             # 0 = unlimited
    #   window: 120s

  - name: worker
    source: github
    command: >-
      celery -A myproject worker
      --loglevel=INFO --concurrency=4
    schedules:
      - name: weekday-report
        cronExpression: "0 9 * * 1-5"
        command: "python manage.py send_report"
        shellType: bash
        timezone: America/Chicago
      # - name: nightly-cleanup
      #   cronExpression: "0 0 * * *"
      #   command: "python manage.py cleanup"
      #   enabled: false

  # Docker app with {ref} resolution — {redis} is replaced with the
  # Dokploy-assigned appName for the "redis" app at setup time
  - name: monitor
    source: docker
    dockerImage: mher/flower:2.0.1
    command: >-
      celery --broker=redis://{redis}:6379/0 flower
      --port=5555 --address=0.0.0.0
    env: |
      TZ=UTC
      CELERY_BROKER_URL=redis://{redis}:6379/0

# Custom SSL/TLS certificates (uploaded during setup)
# Domains can reference these by name with certificateType: custom
certificates:
  - name: wildcard-example
    certFile: certs/wildcard.pem     # path relative to repo root
    keyFile: certs/wildcard.key      # path relative to repo root
    autoRenew: false                 # optional

# S3-compatible destinations for database/volume backups
# destinations:
#   - name: s3-backups
#     accessKey: AKIAIOSFODNN7EXAMPLE
#     secretAccessKey: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#     bucket: my-dokploy-backups
#     region: us-east-1
#     endpoint: https://s3.amazonaws.com

# Database resources (created and deployed during setup)
# Supported types: postgres, mysql, mariadb, mongo, redis
database:
  - name: app-db
    type: postgres
    # dockerImage: postgres:16   # optional, defaults per type
    databaseName: myapp
    databaseUser: myuser
    databasePassword: changeme
    # description: "Primary application database"
    # Scheduled backups (postgres, mysql, mariadb, mongo only — not redis)
    # backups:
    #   - schedule: "0 0 * * *"
    #     prefix: daily
    #     destination: s3-backups
    #     keepLatestCount: 7
    # Scheduled Docker volume backups (any database type, including redis)
    # volumeBackups:
    #   - name: pg-data
    #     volumeName: app-db_postgres_data
    #     prefix: pg-data
    #     cronExpression: "0 3 * * *"
    #     destination: s3-backups

  # - name: app-cache
  #   type: redis
  #   databasePassword: redis_secret

  # - name: app-mysql
  #   type: mysql
  #   databaseName: myapp
  #   databaseUser: myuser
  #   databasePassword: changeme
  #   databaseRootPassword: rootpw
